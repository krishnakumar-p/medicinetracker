<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MediShelf" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Launch theme: shown until the root gate knows what to display, then swapped. -->
    <style name="Theme.MediShelf.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MediShelf</item>
    </style>
</resources>
